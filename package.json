{
  "name": "venice-video-harness",
  "version": "2.6.0",
  "description": "Standalone consistency-first video production CLI powered by the Venice API",
  "homepage": "https://github.com/jordanurbs/venice-video-harness",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jordanurbs/venice-video-harness.git"
  },
  "bugs": {
    "url": "https://github.com/jordanurbs/venice-video-harness/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "keywords": [
    "venice",
    "venice-ai",
    "ai-video",
    "video-generation",
    "video-cli",
    "video-harness",
    "consistent-video",
    "storyboard",
    "image-to-video",
    "text-to-video",
    "multi-shot",
    "character-consistency"
  ],
  "bin": {
    "venice-video": "dist/mini-drama/cli.js",
    "video-harness": "dist/mini-drama/cli.js",
    "storyboard": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/mini-drama/cli.js",
    "dev": "tsx src/mini-drama/cli.ts",
    "dev:legacy": "tsx src/cli.ts",
    "transcribe": "tsx scripts/transcribe-sources.ts",
    "timeline": "tsx scripts/timeline-view.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\"",
    "prepack": "npm run build",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:legacy": "npm run build && for f in tests/test-*.mjs; do node \"$f\" || exit 1; done",
    "release:check": "npm test && npm run test:legacy && npm audit --omit=dev && npm pack --dry-run",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "fountain-js": "^1.1.0",
    "pdf-parse": "^1.1.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pdf-parse": "^1.1.4",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "scripts/postinstall.mjs"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
