# Local agent state — never check in
agentdb.rvf
agentdb.rvf.lock
ruvector.db

# Provider-local agent config. The knowledge pack lives provider-neutrally in
# .agents/ (renamed from .claude/ in 2.14.0); anything a specific runner drops
# at its own path (e.g. Claude Code's settings.local.json) stays local.
.claude/
.agents/settings.local.json

# Project-specific config files that live alongside a series under output/
# but sometimes appear at the repo root. Per-project, not per-harness.
voices.json

# Per-project handoff notes that sometimes land at the repo root from
# individual productions (e.g. Glass). They're inputs to harness work, not
# part of the reusable harness surface. The harness's own roadmap lives in
# HARNESS_IMPLEMENTATION_NOTES.md.
HANDOFF.md
HANDOFF-*.md
HARNESS_HANDOFF.md
HARNESS_EXTENSIONS_NOTE.md
